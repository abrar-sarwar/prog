# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token (Bot tab in the Developer Portal).
DISCORD_TOKEN=your_discord_bot_token_here

# Discord guild (server) ID used during development for instant slash-command
# sync. Right-click the server icon in Discord (with Developer Mode on) -> Copy
# Server ID.
TEST_GUILD_ID=your_test_guild_id_here

# Supabase Postgres connection string. MUST include the "+asyncpg" driver
# qualifier; SQLAlchemy needs it to dispatch to the async driver.
# Example:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

